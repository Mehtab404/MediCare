# Copy to .env for local development. Never commit .env.

# Postgres connection string. Matches docker-compose.yml.
DATABASE_URL=postgres://medicare:medicare@localhost:5432/medicare

# Set to true when the database requires SSL (Render external connections).
DATABASE_SSL=false

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port for the Express server. Render sets this automatically.
PORT=3001

# development or production
NODE_ENV=development

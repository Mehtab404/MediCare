# Copy to .env for local development. Never commit .env.

# Postgres connection string. Matches docker-compose.yml.
DATABASE_URL=postgres://medicare:medicare@localhost:5432/medicare

# Set to true when the database requires SSL (Render external connections).
DATABASE_SSL=false

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port for the Express server. Render sets this automatically.
PORT=3001

# development or production
NODE_ENV=development

# Optional. Creates the first admin account on server start if it doesn't exist yet.
# The password is only used when the account is created; changing it later has no effect.
ADMIN_USER_ID=admin
ADMIN_PASSWORD=change-me-admin-password

# Optional. Creates a demo patient account on server start if it doesn't exist yet. Handy for trying the app.
# An existing account is never changed. Don't use a password you use anywhere else.
# DEMO_USER_ID=demo
# DEMO_PASSWORD=change-me-demo-password

# Email (optional). Any provider that offers SMTP works (Resend, SendGrid, Gmail, ...).
# Without SMTP_HOST, emails are printed to the server log in development and not sent in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=MediCare <no-reply@yourdomain.com>

# Public address of the site, used for links in emails. Default: http://localhost:8080 (or the Render URL on Render).
# APP_URL=http://localhost:8080
